<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <!-- Jellyfin 10.11 is GA: packages come from NuGet.org. The old
             repo.jellyfin.org/nuget unstable feed is gone (404). -->
        <add key="NuGet.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
</configuration>
